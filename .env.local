# =====================================================================
# .env.local — for `make local` (LocalStack + optional real-AWS via SSO)
# Committed to the repo. Contains no real secrets.
# =====================================================================
APP_ENV=local

# --- Postgres ---
#--------AWS---------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Leaftech123
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres:Leaftech123@msp-guardian.c3e0aogkgkq8.eu-north-1.rds.amazonaws.com:5432/postgres?ssl=require
# -----LOCAL------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=admin
# POSTGRES_DB=MSP_Guardian
# DATABASE_URL=postgresql+asyncpg://postgres:admin@postgres:5432/MSP_Guardian

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=dev-secret-change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_TTL_DAYS=30

# --- LocalStack (stub keys; never expire) ---
# Boto3 honors AWS_ENDPOINT_URL as a default endpoint for ALL clients,
# so in local mode every AWS call is routed to LocalStack — including
# real_aws_client(). That's intentional: no real AWS account needed for
# day-to-day dev. On EC2 this var is absent and boto3 hits real AWS.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Real AWS opt-in (Report Generator Lambda) ---
# To exercise the real-AWS report path from your laptop, do BOTH:
#   1. Configure an SSO profile on the host: `aws configure sso --profile msp-dev`
#      then `aws sso login --profile msp-dev` once per workday.
#   2. Comment out AWS_ENDPOINT_URL above (otherwise boto3 still routes to
#      LocalStack) and uncomment AWS_PROFILE below, then `make reset-local`.
# ~/.aws is mounted into the backend container by docker-compose.local.yml
# so boto3's default credential chain finds the SSO cache and refreshes
# automatically.
# AWS_PROFILE=msp-dev
AWS_REPORT_REGION=us-east-1
AWS_REPORT_LAMBDA_NAME=msp-guardian-report-generator
AWS_REPORT_S3_BUCKET=msp-guardian-reports-dev
AWS_REPORT_INVOKE_TIMEOUT_SECONDS=120
AWS_REPORT_PRESIGNED_URL_TTL_SECONDS=600

# --- S3 buckets and prefixes ---
S3_BUCKET=msp-guardian-poc
S3_TMP_PREFIX=tmp/schema-preview
S3_SAMPLES_PREFIX=samples
S3_LANDING_PREFIX=landing
S3_RAW_PREFIX=raw
S3_CURATED_PREFIX=curated
S3_QUARANTINE_PREFIX=quarantine
S3_REPORTS_PREFIX=reports
S3_MAPPINGS_PREFIX=mappings

# --- DynamoDB / Glue / Secrets / Lambda (LocalStack-emulated) ---
DYNAMODB_TABLE=msp_guardian_mappings
DYNAMODB_CONNECTOR_REGISTRY_TABLE=connector_registry
GLUE_DATABASE=msp_guardian_poc
SECRETS_PREFIX=msp-guardian
LAMBDA_TEST_CONNECTION_NAME=testDatasourceConnection

# --- CORS + frontend ---
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
