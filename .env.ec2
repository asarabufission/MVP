# =====================================================================
# .env.ec2 — for `make ec2` (EC2 Instance Role provides AWS creds)
# Committed to the repo. Replace <set-on-instance> values during deploy.
# No AWS credential vars: boto3's default chain pulls short-lived creds
# from IMDSv2 and refreshes them automatically.
# =====================================================================
APP_ENV=production

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-on-instance>
POSTGRES_DB=MSP_Guardian
DATABASE_URL=postgresql+asyncpg://postgres:<set-on-instance>@postgres:5432/MSP_Guardian

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=<set-on-instance>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- AWS ---
# AWS_ENDPOINT_URL intentionally absent (no LocalStack on EC2)
# AWS_ACCESS_KEY_ID intentionally absent (Instance Role provides)
# AWS_SECRET_ACCESS_KEY intentionally absent (Instance Role provides)
AWS_REGION=us-east-1

# --- Real AWS (Report Generator Lambda) ---
AWS_REPORT_REGION=us-east-1
AWS_REPORT_LAMBDA_NAME=msp-guardian-report-generator
AWS_REPORT_S3_BUCKET=msp-guardian-reports-prod
AWS_REPORT_INVOKE_TIMEOUT_SECONDS=120
AWS_REPORT_PRESIGNED_URL_TTL_SECONDS=600

# --- S3 buckets and prefixes ---
S3_BUCKET=msp-guardian-poc
S3_TMP_PREFIX=tmp/schema-preview
S3_SAMPLES_PREFIX=samples
S3_LANDING_PREFIX=landing
S3_RAW_PREFIX=raw
S3_CURATED_PREFIX=curated
S3_QUARANTINE_PREFIX=quarantine
S3_REPORTS_PREFIX=reports
S3_MAPPINGS_PREFIX=mappings

# --- DynamoDB / Glue / Secrets / Lambda (real AWS) ---
DYNAMODB_TABLE=msp_guardian_mappings
GLUE_DATABASE=msp_guardian_poc
SECRETS_PREFIX=msp-guardian
LAMBDA_TEST_CONNECTION_NAME=testDatasourceConnection

# --- CORS + frontend ---
CORS_ORIGINS=https://demo.example.com
VITE_API_BASE_URL=https://demo.example.com/api/v1
